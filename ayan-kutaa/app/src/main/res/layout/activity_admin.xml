<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_screen">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
         android:text="@string/admin_panel"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etDays"
        android:layout_width="match_parent"
        android:layout_height="56dp"
         android:hint="@string/days_to_add"
        android:inputType="number"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_input"
        android:layout_marginBottom="16dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAddSubscription"
        android:layout_width="match_parent"
        android:layout_height="56dp"
         android:text="@string/add_subscription_days"
         android:contentDescription="@string/add_subscription_days"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:background="@drawable/bg_button_primary"
        android:layout_marginBottom="12dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnResetSubscription"
        android:layout_width="match_parent"
        android:layout_height="56dp"
         android:text="@string/reset_subscription"
         android:contentDescription="@string/reset_subscription"
        android:textAllCaps="false"
        android:background="@drawable/bg_button_secondary"
        android:layout_marginBottom="24dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="48dp"
         android:text="@string/back"
        android:textAllCaps="false"
        android:background="@drawable/bg_button_secondary" />

</LinearLayout>
